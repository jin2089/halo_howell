# 全部文本用 LF
* text=auto eol=lf

# 显式强调这些是文本 + LF（其实已被 * 覆盖）
*.sh   text eol=lf
*.ts   text eol=lf
*.html text eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf binary
*.zip binary
